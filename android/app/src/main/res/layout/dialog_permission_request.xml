<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Step Badge / Tag -->
    <TextView
        android:id="@+id/tvStepBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_button_secondary"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="PERMISSION SETUP (1/3)"
        android:textColor="@color/primary_gold"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tvPermissionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Location Permission"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Dialog Description -->
    <TextView
        android:id="@+id/tvPermissionDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:text="Location permission is required to verify your plant GPS coordinates during attendance Mark IN and Mark OUT."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/rounded_button_secondary"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/permission_continue_button"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAllow"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/rounded_button_primary"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/permission_grant_button"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
